local function getClosestTarget()
    if not Settings.SilentAimEnabled then return nil end
    
    local cam = workspace.CurrentCamera
    local center = cam.ViewportSize / 2
    local myChar = lp.Character
    local myRoot = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("Head"))
    if not myRoot then return nil end
    
    local bestPos = nil
    local closestDistance = math.huge
    
    for _, player in ipairs(plrs:GetPlayers()) do
        if player ~= lp then
            local char = player.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local part = char:FindFirstChild(Settings.AimPart) or char:FindFirstChild("Head")
                
                if part and hum and hum.Health > 0 then
                    if not Settings.WallCheckCombat or isVisible(part) then
                        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local fovDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            if fovDist <= Settings.FOVSize then
                                local worldDist = (part.Position - myRoot.Position).Magnitude
                                if worldDist < closestDistance then
                                    closestDistance = worldDist
                                    bestPos = part.Position
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    return bestPos
end

local old; old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
    if not checkcaller() and getnamecallmethod() == "ViewportPointToRay" and rawequal(self, workspace.CurrentCamera) then
        local ray = old(self, ...)
        local ok, scr = pcall(getcallingscript)
        if ok and scr and scr.Name == "WeaponClient" then
            local ok2, pos = pcall(getClosestTarget)
            if ok2 and pos then
                return Ray.new(ray.Origin, (pos - ray.Origin).Unit)
            end
        end
        return ray
    end
    return old(self, ...)
end))

local function applyGunMods()
    local weaponsFolder = rep:FindFirstChild("Weapons")
    local weaponDataModule = weaponsFolder and weaponsFolder:FindFirstChild("WeaponData")

    if weaponDataModule then
        local successWeapons, weapons = pcall(function()
            return require(weaponDataModule)
        end)

        if successWeapons and type(weapons) == "table" then
            local function makeWritable(t)
                if setreadonly then pcall(function() setreadonly(t, false) end) end
                for k, v in pairs(t) do
                    if type(v) == "table" then
                        if setreadonly then pcall(function() setreadonly(v, false) end) end
                        makeWritable(v)
                    end
                end
            end

            makeWritable(weapons)

            for name, weapon in pairs(weapons) do
                if type(weapon) == "table" then
                    if weapon.Fire then
                        if setreadonly then pcall(function() setreadonly(weapon.Fire, false) end) end
                        weapon.Fire.RPM = Settings.FastFire and 1500 or 600
                        if weapon.Fire.Rocket then
                            if setreadonly then pcall(function() setreadonly(weapon.Fire.Rocket, false) end) end
                            weapon.Fire.Rocket.Speed = Settings.FastBullet and 9999 or 500
                        end
                    end
                    
                    if weapon.Bullet then
                        if setreadonly then pcall(function() setreadonly(weapon.Bullet, false) end) end
                        weapon.Bullet.Speed = Settings.FastBullet and 99999 or 1000
                    end
                    
                    if weapon.Recoil then
                        if setreadonly then pcall(function() setreadonly(weapon.Recoil, false) end) end
                        weapon.Recoil.Up = Settings.NoRecoil and 0 or 1
                        weapon.Recoil.Side = Settings.NoRecoil and 0 or 1
                        weapon.Recoil.AimScale = Settings.NoRecoil and 0 or 1
                        if weapon.Recoil.Return then
                            weapon.Recoil.Return = Settings.NoRecoil and 10 or 1
                        end
                    end
                    
                    if weapon.Bloom then
                        if setreadonly then pcall(function() setreadonly(weapon.Bloom, false) end) end
                        weapon.Bloom.Hip = Settings.NoSpread and 0 or 1
                        weapon.Bloom.Aim = Settings.NoSpread and 0 or 1
                        weapon.Bloom.Move = Settings.NoSpread and 0 or 1
                        weapon.Bloom.Air = Settings.NoSpread and 0 or 1
                        weapon.Bloom.PerShot = Settings.NoSpread and 0 or 1
                        weapon.Bloom.Max = Settings.NoSpread and 0 or 1
                    end
                end
            end
        end
    end
end

