local function createInstance(cls, props)
	local inst = Instance.new(cls)
	for k, v in pairs(props) do inst[k] = v end
	return inst
end

local function worldToScreen(pos)
	local vp = cam.ViewportSize
	local lpos = cam.CFrame:pointToObjectSpace(pos)
	local ar = vp.X / vp.Y
	local hy = -lpos.Z * math.tan(math.rad(cam.FieldOfView / 2))
	local hx = ar * hy
	local corner = Vector3.new(-hx, hy, lpos.Z)
	local rel = lpos - corner
	local sx = rel.X / (hx * 2)
	local sy = -rel.Y / (hy * 2)
	local on_scr = -lpos.Z > 0 and sx >= 0 and sx <= 1 and sy >= 0 and sy <= 1
	return Vector3.new(sx * vp.X, sy * vp.Y, -lpos.Z), on_scr
end

local function connectESP(sig, fn)
