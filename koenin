local function buildConfig(name)
	local cfg = Window.ConfigManager:CreateConfig(name)
	cfg:RegisterElement("SilentAim", silentAimToggle)
	cfg:RegisterElement("WallCheckCombat", wallCheckCombatToggle)
	cfg:RegisterElement("AimPart", aimPartDropdown)
	cfg:RegisterElement("FOVVisible", fovToggle)
	cfg:RegisterElement("FOVSize", fovSlider)
	cfg:RegisterElement("FOVColor", fovColorPicker)
	cfg:RegisterElement("ConfigName", configName)
	return cfg
end

