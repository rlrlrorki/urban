local function calculateBox(torso)
	if not torso then return nil, nil, nil end
	local top_v = torso.Position + (torso.CFrame.UpVector * 1.8) + cam.CFrame.UpVector
	local bot_v = torso.Position - (torso.CFrame.UpVector * 2.5) - cam.CFrame.UpVector
	local dist = (torso.Position - cam.CFrame.p).Magnitude
	local top, top_on = worldToScreen(top_v)
	local bot, _ = worldToScreen(bot_v)
	local w = math.max(math.floor(math.abs(top.X - bot.X)), 8)
	local h = math.max(math.floor(math.max(math.abs(bot.Y - top.Y), w / 2)), 12)
	local sz = Vector2.new(math.floor(math.max(h / 1.5, w)), h)
	local pos = Vector2.new(math.floor(top.X * 0.5 + bot.X * 0.5 - sz.X * 0.5), math.floor(math.min(top.Y, bot.Y)))
	return sz, pos, top_on, dist
end

local function isVisible(targetPart)
	if not targetPart or not lp.Character then return false end
	local origin = cam.CFrame.Position
	
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	
	local ignoreList = {lp.Character, cam}
	local targetModel = targetPart:FindFirstAncestorOfClass("Model")
	if targetModel then
		table.insert(ignoreList, targetModel)
	end
	
	local carsFolder = workspace:FindFirstChild("Cars")
	if carsFolder then
		table.insert(ignoreList, carsFolder)
	end
	
	local maxTries = 5
	for _ = 1, maxTries do
		local direction = (targetPart.Position - origin)
		raycastParams.FilterDescendantsInstances = ignoreList
		raycastParams.IgnoreWater = true
		
		local result = workspace:Raycast(origin, direction, raycastParams)
		if not result then
			return true
		end
		
		local hitPart = result.Instance
		if hitPart then
			local hitModel = hitPart:FindFirstAncestorOfClass("Model")
			local isVehicle = false
			if carsFolder and hitPart:IsDescendantOf(carsFolder) then
				isVehicle = true
			elseif hitPart.Parent and (hitPart.Parent:FindFirstChild("Steering") or hitPart.Parent:FindFirstChild("Seat") or hitPart.Parent:IsA("VehicleSeat")) then
				isVehicle = true
			elseif hitModel and (hitModel:FindFirstChild("Wheels") or hitModel:FindFirstChild("Body") or hitModel.Name:lower():find("car") or hitModel.Name:lower():find("vehicle") or hitModel.Name:lower():find("bike")) then
				isVehicle = true
			end
			
			if isVehicle and hitModel then
				table.insert(ignoreList, hitModel)
			else
				if hitModel and targetModel and hitModel == targetModel then
					return true
				end
				return false
			end
		else
			return true
		end
	end
	return false
end

local function getHealthColor(percent)
	percent = math.clamp(percent, 0, 1)
	if percent > 0.5 then
		return Color3.fromRGB(255, 255, 0):Lerp(Color3.fromRGB(0, 255, 0), (percent - 0.5) * 2)
	else
		return Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(255, 255, 0), percent * 2)
	end
end

