	items.Box = createInstance("Frame", { Parent = items.Holder, BackgroundTransparency = 1, Position = UDim2.new(0,1,0,1), Size = UDim2.new(1,-2,1,-2) })
	createInstance("UIStroke", { Parent = items.Box, LineJoinMode = Enum.LineJoinMode.Miter })
	items.Inner = createInstance("Frame", { Parent = items.Box, BackgroundTransparency = 1, Size = UDim2.new(1,0,1,0) })
	createInstance("UIStroke", { Color = esp_cfg.BoxColor, Parent = items.Inner })

	items.Healthbar = createInstance("Frame", { Name = "Left", Parent = items.Holder, BackgroundColor3 = Color3.fromRGB(0,0,0), Size = UDim2.new(0,3,1,0), Position = UDim2.new(0,-5,0,0) })
	items.HealthbarFill = createInstance("Frame", { Parent = items.Healthbar, BackgroundColor3 = Color3.fromRGB(0,255,0), BorderSizePixel = 0, Position = UDim2.new(0,1,0,1), Size = UDim2.new(1,-2,1,-2) })

	items.Text = createInstance("TextLabel", { FontFace = fonts.pixel, TextColor3 = esp_cfg.Name_Text_Color, Parent = items.TopTexts, Text = player.Name, BackgroundTransparency = 1, TextSize = 12, AutomaticSize = Enum.AutomaticSize.XY })
	createInstance("UIStroke", { Parent = items.Text })

	items.Distance = createInstance("TextLabel", { FontFace = fonts.pixel, TextColor3 = esp_cfg.Distance_Text_Color, Parent = items.BottomTexts, BackgroundTransparency = 1, TextSize = 10, AutomaticSize = Enum.AutomaticSize.XY })
	createInstance("UIStroke", { Parent = items.Distance })

	data.HealthChanged = function(val)
		if not data.Info.Humanoid then return end
		local maxHealth = data.Info.Humanoid.MaxHealth > 0 and data.Info.Humanoid.MaxHealth or 100
		local mult = math.clamp(val / maxHealth, 0, 1)
		
		items.HealthbarFill.Size = UDim2.new(1, -2, mult, -2)
		items.HealthbarFill.Position = UDim2.new(0, 1, 1 - mult, 1)
		items.HealthbarFill.BackgroundColor3 = getHealthColor(mult)
	end

	data.Refresh = function()
		local char = player.Character or player.CharacterAdded:Wait()
		local hum = char:WaitForChild("Humanoid", 5)
		if not hum then return end
		data.Info.Character = char
		data.Info.Humanoid = hum
		data.Info.RootPart = hum.RootPart

		if data.HealthConn then data.HealthConn:Disconnect() end
		data.HealthConn = hum.HealthChanged:Connect(data.HealthChanged)
		Esp.Connections[#Esp.Connections + 1] = data.HealthConn
		data.HealthChanged(hum.Health)
	end

	data.Destroy = function()
		if data.HealthConn then data.HealthConn:Disconnect() end
		if items.Holder then items.Holder:Destroy() end
		if Esp.Players[player.Name] then Esp.Players[player.Name] = nil end
	end

	if player.Character then task.spawn(data.Refresh) end
	connectESP(player.CharacterAdded, data.Refresh)
	Esp.Players[player.Name] = data
	return data
end

local function updateESP()
	if not Esp or not esp_cfg.Enabled then
		for _, d in pairs(Esp.Players) do
			if d.Items.Holder then d.Items.Holder.Visible = false end
		end
		return
	end
	
	for _, d in pairs(Esp.Players) do
		local char, hum = d.Info.Character, d.Info.Humanoid
		if not (char and hum and char.Parent and hum.Health > 0) then
			if d.Items.Holder then d.Items.Holder.Visible = false end
			continue
		end

		local box_sz, box_pos, on_scr, dist = calculateBox(hum.RootPart)
		local holder = d.Items.Holder
		if not holder or dist == nil or dist > esp_cfg["Render Distance"] then
			if holder.Visible then holder.Visible = false end
			continue
		end

		holder.Visible = on_scr
		if not on_scr then continue end
		holder.Position = UDim2.fromOffset(box_pos.X, box_pos.Y)
		holder.Size = UDim2.new(0, box_sz.X, 0, box_sz.Y)
		d.Items.Distance.Text = tostring(math.round(dist)) .. "m"
		
		local targetPart = char:FindFirstChild("Head") or hum.RootPart
		local dynamicColor = esp_cfg.BoxColor
		if esp_cfg.WallCheck and targetPart then
			local visible = isVisible(targetPart)
			dynamicColor = visible and esp_cfg.VisibleColor or esp_cfg.InvisibleColor
			d.Items.Inner.UIStroke.Color = dynamicColor
			d.Items.Text.TextColor3 = dynamicColor
		else
			d.Items.Inner.UIStroke.Color = esp_cfg.BoxColor
			d.Items.Text.TextColor3 = esp_cfg.Name_Text_Color
		end

		d.Items.Box.Visible = esp_cfg.Boxes
		d.Items.Healthbar.Visible = esp_cfg.Healthbar
		d.Items.Text.Visible = esp_cfg.EspName
		d.Items.Distance.Visible = esp_cfg.Distance_Text
	end
end

function Esp.Unload()
	for _, p in pairs(plrs:GetPlayers()) do if Esp.Players[p.Name] then Esp.Players[p.Name].Destroy() end end
	for _, c in pairs(Esp.Connections) do pcall(function() c:Disconnect() end) end
	Esp.Connections = {}
	if Esp.Loop then pcall(function() rs:UnbindFromRenderStep("Run Loop") end) end
	pcall(function() Esp.Cache:Destroy() end)
	pcall(function() Esp.ScreenGui:Destroy() end)
	getgenv().Esp = nil
end

