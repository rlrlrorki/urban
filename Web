<!DOCTYPE html>
<html lang="th" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KEI Store — ศูนย์รวมคีย์ดิจิทัลคุณภาพ ส่งไวอัตโนมัติ 24 ชม.</title>

    <!-- Google Fonts: Prompt, Kanit และ JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700&family=Kanit:wght@400;500;600;700;800&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- ตั้งค่าสีและฟอนต์สำหรับ Tailwind CSS -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Prompt', 'sans-serif'],
                        display: ['Kanit', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        dark: {
                            950: '#090512',
                            900: '#0f081c',
                            800: '#170d2b',
                            700: '#22143d',
                        },
                        neon: {
                            400: '#c084fc',
                            500: '#a855f7',
                            600: '#8b5cf6',
                        }
                    },
                    boxShadow: {
                        'neon': '0 0 20px rgba(139, 92, 246, 0.35)',
                        'neon-strong': '0 0 35px rgba(168, 85, 247, 0.55)',
                        'card-hover': '0 10px 40px -10px rgba(139, 92, 246, 0.35)',
                    }
                }
            }
        }
    </script>

    <!-- Custom CSS สำหรับ Glassmorphism, Neon Glow และ Animation -->
    <style>
        body {
            background-color: #090512;
            color: #f3e8ff;
            overflow-x: hidden;
        }

        /* ลายตารางพื้นหลังสไตล์ไซเบอร์ */
        .bg-grid-pattern {
            background-image:
                linear-gradient(to right, rgba(139, 92, 246, 0.06) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(139, 92, 246, 0.06) 1px, transparent 1px);
            background-size: 40px 40px;
        }

        /* เอฟเฟกต์ Glassmorphism */
        .glass {
            background: rgba(15, 8, 28, 0.74);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(168, 85, 247, 0.2);
        }

        .glass-card {
            background: linear-gradient(145deg, rgba(25, 14, 46, 0.8) 0%, rgba(13, 7, 25, 0.9) 100%);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(168, 85, 247, 0.18);
        }

        .glass-card:hover {
            border-color: rgba(192, 132, 252, 0.48);
        }

        /* ข้อความเรืองแสง */
        .text-glow {
            text-shadow: 0 0 26px rgba(168, 85, 247, 0.65);
        }

        /* ซ่อน Scrollbar สำหรับแถบหมวดหมู่บนมือถือ */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* ปรับแต่ง Scrollbar หลัก */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090512;
        }
        ::-webkit-scrollbar-thumb {
            background: #2e1a4d;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #8b5cf6;
        }

        /* แอนิเมชันลอยเบาๆ */
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
        }
        .animate-float {
            animation: floatSlow 5s ease-in-out infinite;
        }

        /* แอนิเมชัน Toast Notification */
        @keyframes slideInUp {
            from { opacity: 0; transform: translateY(20px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .toast-enter {
            animation: slideInUp 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="min-h-screen bg-dark-950 bg-grid-pattern selection:bg-neon-600 selection:text-white flex flex-col">

    <!-- แสงเรืองรองพื้นหลัง (Ambient Purple Glow Orbs) -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
        <div class="absolute -top-32 -left-32 w-96 h-96 bg-neon-600/20 rounded-full blur-[120px]"></div>
        <div class="absolute top-1/3 -right-32 w-[28rem] h-[28rem] bg-fuchsia-600/15 rounded-full blur-[130px]"></div>
        <div class="absolute bottom-0 left-1/3 w-80 h-80 bg-violet-700/15 rounded-full blur-[120px]"></div>
    </div>

    <!-- ==================== 1. แถบนำทาง (Navbar) ==================== -->
    <header class="sticky top-0 z-40 glass border-b border-purple-500/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 md:h-20 gap-3">
                
                <!-- โลโก้และชื่อร้าน KEI Store -->
                <a href="#home" class="flex items-center gap-2.5 group shrink-0">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-neon-600 to-fuchsia-600 flex items-center justify-center shadow-neon group-hover:shadow-neon-strong transition-all duration-300 group-hover:scale-105">
                        <i data-lucide="key-round" class="w-5 h-5 text-white"></i>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-display font-extrabold text-xl tracking-wide bg-gradient-to-r from-white via-purple-200 to-neon-400 bg-clip-text text-transparent">
                            KEI Store
                        </span>
                        <span class="text-[10px] text-purple-300/70 -mt-1 tracking-wider uppercase">Digital Key Shop</span>
                    </div>
                </a>

                <!-- เมนูหลักสำหรับหน้าจอใหญ่ -->
                <nav class="hidden md:flex items-center gap-1 lg:gap-2">
                    <a href="#home" class="px-3.5 py-2 rounded-xl text-sm font-medium text-purple-100 hover:text-white hover:bg-purple-500/15 transition">
                        หน้าแรก
                    </a>
                    <a href="#products" class="px-3.5 py-2 rounded-xl text-sm font-medium text-purple-200/80 hover:text-white hover:bg-purple-500/15 transition">
                        สินค้าทั้งหมด
                    </a>
                    <button onclick="openHistoryModal()" class="px-3.5 py-2 rounded-xl text-sm font-medium text-purple-200/80 hover:text-white hover:bg-purple-500/15 transition flex items-center gap-1.5">
                        <i data-lucide="history" class="w-4 h-4 text-neon-400"></i>
                        ประวัติการสั่งซื้อ
                    </button>
                </nav>

                <!-- ค้นหา + ปุ่มประวัติ + ปุ่มตะกร้า -->
                <div class="flex items-center gap-2 sm:gap-3 flex-1 md:flex-initial justify-end">
                    <!-- ช่องค้นหา (Desktop) -->
                    <div class="relative hidden sm:block w-48 lg:w-64">
                        <i data-lucide="search" class="w-4 h-4 text-purple-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                        <input
                            type="text"
                            id="searchInputDesktop"
                            oninput="handleSearch(this.value)"
                            placeholder="ค้นหาคีย์สินค้า..."
                            class="w-full pl-10 pr-4 py-2 rounded-xl bg-dark-900/80 border border-purple-500/25 text-sm text-white placeholder-purple-300/40 focus:outline-none focus:border-neon-400 focus:ring-2 focus:ring-neon-500/25 transition"
                        >
                    </div>

                    <!-- ปุ่มประวัติการสั่งซื้อ (Mobile) -->
                    <button onclick="openHistoryModal()" aria-label="ประวัติการสั่งซื้อ" class="md:hidden p-2.5 rounded-xl bg-dark-800/80 border border-purple-500/25 text-purple-200 hover:text-white hover:border-neon-400 transition active:scale-95">
                        <i data-lucide="history" class="w-5 h-5"></i>
                    </button>

                    <!-- ปุ่มตะกร้าสินค้า -->
                    <button onclick="openCartDrawer()" class="relative flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-gradient-to-r from-neon-600/90 to-purple-600/90 hover:from-neon-500 hover:to-fuchsia-600 text-white font-medium text-sm shadow-neon hover:shadow-neon-strong transition-all active:scale-95">
                        <i data-lucide="shopping-cart" class="w-4 h-4 sm:w-5 sm:h-5"></i>
                        <span class="hidden sm:inline">ตะกร้า</span>
                        <span id="cartBadge" class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 text-xs font-bold rounded-full bg-white text-dark-950 transition-transform">
                            0
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- ==================== 2. ส่วนแบนเนอร์หลัก (Hero Banner) ==================== -->
    <main class="relative z-10 flex-1">
        <section id="home" class="pt-10 pb-14 sm:pt-20 sm:pb-24 px-4 sm:px-6 lg:px-8">
            <div class="max-w-7xl mx-auto text-center">
                
                <!-- ป้ายสถานะระบบออนไลน์ -->
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass border border-neon-500/35 text-xs sm:text-sm text-purple-200 mb-6 animate-float">
                    <span class="relative flex h-2.5 w-2.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                    </span>
                    ระบบส่งคีย์อัตโนมัติ KEI Store เปิดให้บริการ 24 ชม.
                </div>

                <!-- หัวข้อหลัก -->
                <h1 class="font-display font-extrabold text-3xl sm:text-5xl lg:text-6xl tracking-tight leading-tight max-w-4xl mx-auto mb-5">
                    <span class="bg-gradient-to-r from-neon-400 via-fuchsia-400 to-purple-300 bg-clip-text text-transparent text-glow">KEI Store</span>
                    <span class="text-white block sm:inline"> — ศูนย์รวมคีย์ดิจิทัล</span>
                    <span class="block text-purple-100 mt-1 sm:mt-2">ส่งไวอัตโนมัติใน 1 วินาที</span>
                </h1>

                <!-- คำอธิบายร้าน -->
                <p class="text-purple-200/80 text-sm sm:text-base lg:text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
                    ซื้อคีย์ได้ทันทีไม่ต้องรอแอดมิน รองรับทั้งการสแกน PromptPay QR และซองอั่งเปา TrueMoney Wallet ระบบตรวจสอบและจัดส่งรหัสคีย์พร้อมใช้งานอัตโนมัติตลอด 24 ชั่วโมง
                </p>

                <!-- ปุ่ม Action หลัก -->
                <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4 mb-12 sm:mb-16">
                    <a href="#products" class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-gradient-to-r from-neon-600 via-purple-600 to-fuchsia-600 hover:from-neon-500 hover:to-fuchsia-500 text-white font-semibold text-base shadow-neon hover:shadow-neon-strong transition-all duration-300 flex items-center justify-center gap-2 active:scale-95">
                        <i data-lucide="zap" class="w-5 h-5"></i>
                        ดูรายการคีย์ทั้งหมด
                    </a>
                    <button onclick="openHistoryModal()" class="w-full sm:w-auto px-8 py-3.5 rounded-2xl glass hover:bg-purple-500/15 border border-purple-400/30 hover:border-neon-400 text-purple-100 font-semibold text-base transition-all duration-300 flex items-center justify-center gap-2 active:scale-95">
                        <i data-lucide="key" class="w-5 h-5 text-neon-400"></i>
                        ดูประวัติการสั่งซื้อ
                    </button>
                </div>

                <!-- จุดเด่นของร้าน 3 ข้อ -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-4xl mx-auto">
                    <div class="glass-card rounded-2xl p-5 flex items-center gap-4 text-left">
                        <div class="w-12 h-12 rounded-xl bg-neon-600/20 border border-neon-500/30 flex items-center justify-center shrink-0">
                            <i data-lucide="zap" class="w-6 h-6 text-neon-400"></i>
                        </div>
                        <div>
                            <div class="font-display font-bold text-lg sm:text-xl text-white">ส่งคีย์อัตโนมัติ 24 ชม.</div>
                            <div class="text-xs sm:text-sm text-purple-300/75">ชำระเงินปุ๊บ รับรหัสคีย์ทันที</div>
                        </div>
                    </div>

                    <div class="glass-card rounded-2xl p-5 flex items-center gap-4 text-left">
                        <div class="w-12 h-12 rounded-xl bg-fuchsia-600/20 border border-fuchsia-500/30 flex items-center justify-center shrink-0">
                            <i data-lucide="shield-check" class="w-6 h-6 text-fuchsia-400"></i>
                        </div>
                        <div>
                            <div class="font-display font-bold text-lg sm:text-xl text-white">ปลอดภัย 100%</div>
                            <div class="text-xs sm:text-sm text-purple-300/75">รับประกันคีย์แท้ใช้งานได้จริงทุกดอก</div>
                        </div>
                    </div>

                    <div class="glass-card rounded-2xl p-5 flex items-center gap-4 text-left">
                        <div class="w-12 h-12 rounded-xl bg-violet-600/20 border border-violet-500/30 flex items-center justify-center shrink-0">
                            <i data-lucide="headphones" class="w-6 h-6 text-violet-400"></i>
                        </div>
                        <div>
                            <div class="font-display font-bold text-lg sm:text-xl text-white">ซัพพอร์ตไว</div>
                            <div class="text-xs sm:text-sm text-purple-300/75">ทีมงานพร้อมช่วยเหลือผ่าน Discord</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ==================== 3. ค้นหา กรองหมวดหมู่ และรายการสินค้า ==================== -->
        <section id="products" class="py-10 sm:py-16 px-4 sm:px-6 lg:px-8">
            <div class="max-w-7xl mx-auto">
                
                <!-- หัวข้อ + ป้ายโค้ดส่วนลด -->
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-7">
                    <div>
                        <span class="text-xs font-semibold uppercase tracking-widest text-neon-400">KEI Store Catalog</span>
                        <h2 class="font-display font-bold text-2xl sm:text-3xl text-white mt-1">
                            เลือกแพ็กเกจคีย์ที่ต้องการ
                        </h2>
                    </div>

                    <!-- ปุ่มคัดลอกโค้ดส่วนลด KEI10 -->
                    <button onclick="copyText('KEI10', 'คัดลอกโค้ดส่วนลด KEI10 แล้ว!')" class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-xl bg-purple-900/40 border border-dashed border-neon-400/50 hover:border-neon-400 hover:bg-purple-800/40 transition text-left group self-start md:self-auto active:scale-95">
                        <i data-lucide="ticket-percent" class="w-5 h-5 text-neon-400 shrink-0"></i>
                        <div class="text-xs sm:text-sm">
                            <span class="text-purple-200">ใส่โค้ด </span>
                            <span class="font-mono font-bold text-neon-400 group-hover:underline">KEI10</span>
                            <span class="text-purple-200"> ลดทันที 10% (แตะเพื่อคัดลอก)</span>
                        </div>
                    </button>
                </div>

                <!-- ช่องค้นหาบนมือถือ -->
                <div class="relative sm:hidden mb-4">
                    <i data-lucide="search" class="w-4 h-4 text-purple-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none"></i>
                    <input
                        type="text"
                        id="searchInputMobile"
                        oninput="handleSearch(this.value)"
                        placeholder="ค้นหาคีย์สินค้า..."
                        class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-dark-900/90 border border-purple-500/25 text-sm text-white placeholder-purple-300/40 focus:outline-none focus:border-neon-400 transition"
                    >
                </div>

                <!-- แถบตัวกรองหมวดหมู่ -->
                <div id="categoryTabs" class="flex items-center gap-2 overflow-x-auto pb-3 mb-6 no-scrollbar">
                    <!-- เรนเดอร์ด้วย JavaScript -->
                </div>

                <!-- ตารางรายการสินค้า -->
                <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
                    <!-- เรนเดอร์ด้วย JavaScript -->
                </div>

                <!-- แสดงเมื่อไม่พบสินค้าที่ค้นหา -->
                <div id="emptyProductState" class="hidden text-center py-16 glass-card rounded-3xl">
                    <div class="w-16 h-16 rounded-2xl bg-purple-500/15 border border-purple-500/30 flex items-center justify-center mx-auto mb-4">
                        <i data-lucide="search-x" class="w-8 h-8 text-purple-300"></i>
                    </div>
                    <h3 class="font-display font-semibold text-xl text-white mb-1">ไม่พบสินค้าที่ค้นหา</h3>
                    <p class="text-sm text-purple-300/70 mb-4">ลองเปลี่ยนคำค้นหา หรือเลือกดูสินค้าในหมวดหมู่ทั้งหมด</p>
                    <button onclick="resetFilters()" class="px-5 py-2.5 rounded-xl bg-neon-600 hover:bg-neon-500 text-white text-sm font-medium transition">
                        แสดงสินค้าทั้งหมด
                    </button>
                </div>
            </div>
        </section>
    </main>

    <!-- ==================== 4. ส่วนท้าย (Footer) ==================== -->
    <footer class="relative z-10 mt-14 border-t border-purple-500/20 bg-dark-900/80 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
                <!-- แบรนด์ KEI Store -->
                <div>
                    <div class="flex items-center gap-2.5 mb-3">
                        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-neon-600 to-fuchsia-600 flex items-center justify-center shadow-neon">
                            <i data-lucide="key-round" class="w-4 h-4 text-white"></i>
                        </div>
                        <span class="font-display font-extrabold text-xl text-white">KEI Store</span>
                    </div>
                    <p class="text-sm text-purple-200/70 leading-relaxed">
                        ร้านจำหน่ายคีย์ดิจิทัลคุณภาพสูง ระบบจัดส่งอัตโนมัติ 24 ชั่วโมง ปลอดภัย ใช้งานง่าย พร้อมทีมงานซัพพอร์ตคอยดูแลอย่างใกล้ชิด
                    </p>
                </div>

                <!-- เมนูลัด -->
                <div>
                    <h4 class="font-display font-semibold text-white mb-3">เมนูลัด</h4>
                    <ul class="space-y-2 text-sm text-purple-200/75">
                        <li><a href="#home" class="hover:text-neon-400 transition">หน้าแรก</a></li>
                        <li><a href="#products" class="hover:text-neon-400 transition">สินค้าทั้งหมด</a></li>
                        <li><button onclick="openHistoryModal()" class="hover:text-neon-400 transition">ประวัติการสั่งซื้อ</button></li>
                        <li><button onclick="openCartDrawer()" class="hover:text-neon-400 transition">ตะกร้าสินค้า</button></li>
                    </ul>
                </div>

                <!-- ช่องทางติดต่อร้านค้า -->
                <div>
                    <h4 class="font-display font-semibold text-white mb-3">ติดต่อร้าน KEI Store</h4>
                    <div class="flex flex-col gap-2.5">
                        <button onclick="copyText('https://discord.gg/keistore', 'คัดลอกลิงก์ Discord ร้าน KEI Store แล้ว!')" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-indigo-500/15 border border-indigo-400/25 hover:border-indigo-400/60 text-indigo-200 text-sm transition text-left active:scale-[0.99]">
                            <i data-lucide="message-circle" class="w-5 h-5 text-indigo-400 shrink-0"></i>
                            <div>
                                <div class="font-semibold text-white">Discord Official</div>
                                <div class="text-xs text-indigo-300/80">discord.gg/keistore (ซัพพอร์ต 24 ชม.)</div>
                            </div>
                        </button>
                    </div>
                </div>
            </div>

            <div class="pt-6 border-t border-purple-500/15 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-purple-300/60">
                <p>&copy; 2026 KEI Store. สงวนลิขสิทธิ์ทั้งหมด</p>
                <p class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                    ระบบจัดส่งอัตโนมัติพร้อมใช้งาน
                </p>
            </div>
        </div>
    </footer>

    <!-- ==================== 5. ตะกร้าสินค้า (Slide-over Drawer) ==================== -->
