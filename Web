        // ==================== ระบบตะกร้าสินค้า ====================

        function addToCart(productId, silent = false) {
            const product = PRODUCTS.find(p => p.id === productId);
            if (!product || product.stock <= 0) {
                showToast('สินค้าหมดชั่วคราว', 'error');
                return;
            }

            const existing = cart.find(item => item.productId === productId);
            if (existing) {
                if (existing.quantity >= product.stock) {
                    showToast('จำนวนสินค้าในตะกร้าครบตามสต็อกที่มีแล้ว', 'error');
                    return;
                }
                existing.quantity += 1;
            } else {
                cart.push({ productId, quantity: 1 });
            }

            updateCartUI();
            if (!silent) {
                showToast(`เพิ่ม "${product.name}" ลงตะกร้าแล้ว`, 'info');
            }
        }

        function buyNow(productId) {
            const existing = cart.find(item => item.productId === productId);
            if (!existing) {
                addToCart(productId, true);
            }
            openCheckoutModal();
        }

        function updateCartQuantity(productId, delta) {
            const index = cart.findIndex(item => item.productId === productId);
            if (index === -1) return;

            const product = PRODUCTS.find(p => p.id === productId);
            const newQty = cart[index].quantity + delta;

            if (newQty <= 0) {
                cart.splice(index, 1);
            } else if (product && newQty > product.stock) {
                showToast('ไม่สามารถเพิ่มเกินจำนวนสต็อกคงเหลือได้', 'error');
                return;
            } else {
                cart[index].quantity = newQty;
            }

            updateCartUI();
        }

        function removeFromCart(productId) {
            cart = cart.filter(item => item.productId !== productId);
            updateCartUI();
        }

        function calculateTotals() {
            const subtotal = cart.reduce((sum, item) => {
                const product = PRODUCTS.find(p => p.id === item.productId);
                return sum + (product ? product.price * item.quantity : 0);
            }, 0);
            const discount = appliedPromo === 'KEI10' ? Math.round(subtotal * 0.10) : 0;
            const total = Math.max(0, subtotal - discount);
            const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
            return { subtotal, discount, total, totalItems };
        }

