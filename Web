        /**
         * สุ่มสร้างคีย์รูปแบบ KEI-XXXX-XXXX-XXXX
         */
        function generateLicenseKey() {
            const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
            const segment = () => {
                let str = '';
                for (let i = 0; i < 4; i++) {
                    str += chars.charAt(Math.floor(Math.random() * chars.length));
                }
                return str;
            };
            return `KEI-${segment()}-${segment()}-${segment()}`;
        }

        /**
         * ยืนยันการชำระเงิน -> แสดงแอนิเมชันตรวจสอบ 1 วินาที -> สุ่มคีย์และบันทึกประวัติ
         */
        function processPayment() {
            if (selectedPaymentMethod === 'truemoney') {
                const link = document.getElementById('angpaoLinkInput').value.trim();
                if (!link) {
                    showToast('กรุณาวางลิงก์ซองอั่งเปา TrueMoney ก่อนยืนยัน', 'error');
                    return;
                }
            }

            document.getElementById('checkoutStepPayment').classList.add('hidden');
            document.getElementById('checkoutStepLoading').classList.remove('hidden');

            setTimeout(() => {
                const { subtotal, discount, total } = calculateTotals();
                const generatedItems = [];

                cart.forEach(item => {
                    const product = PRODUCTS.find(p => p.id === item.productId);
                    if (!product) return;

                    product.stock = Math.max(0, product.stock - item.quantity);

                    for (let i = 0; i < item.quantity; i++) {
                        generatedItems.push({
                            productName: product.name,
                            price: product.price,
                            key: generateLicenseKey()
                        });
                    }
                });

                lastDeliveredKeys = generatedItems.map(i => i.key);

                const newOrder = {
                    orderId: `KEI-${Date.now().toString().slice(-6)}`,
                    date: new Date().toLocaleString('th-TH', {
                        year: 'numeric', month: 'short', day: 'numeric',
                        hour: '2-digit', minute: '2-digit'
                    }),
                    paymentMethod: selectedPaymentMethod === 'promptpay' ? 'PromptPay QR' : 'ซองอั่งเปา TrueMoney',
                    subtotal,
                    discount,
                    total,
                    items: generatedItems
                };

                saveOrderToHistory(newOrder);

                cart = [];
                appliedPromo = null;
                document.getElementById('angpaoLinkInput').value = '';
                updateCartUI();
                renderProducts();

                renderDeliveredKeys(generatedItems);
                document.getElementById('checkoutStepLoading').classList.add('hidden');
                document.getElementById('checkoutStepSuccess').classList.remove('hidden');
                document.getElementById('checkoutModalTitle').innerHTML = '<i data-lucide="sparkles" class="w-5 h-5 text-emerald-400"></i> รับคีย์สินค้าสำเร็จ';
                lucide.createIcons();
                showToast('ชำระเงินสำเร็จ! รับรหัสคีย์ของคุณได้เลย', 'success');
            }, 1000);
        }

        function renderDeliveredKeys(items) {
            const container = document.getElementById('deliveredKeysList');
            container.innerHTML = items.map(item => `
                <div class="p-3.5 rounded-2xl bg-dark-950/80 border border-neon-500/30 flex items-center justify-between gap-3">
                    <div class="min-w-0">
                        <div class="text-xs text-purple-300/75 truncate">${item.productName}</div>
                        <div class="font-mono font-bold text-sm sm:text-base text-neon-400 tracking-wider select-all mt-0.5">${item.key}</div>
                    </div>
                    <button onclick="copyText('${item.key}', 'คัดลอกคีย์ ${item.key} แล้ว!')" class="px-3 py-2 rounded-xl bg-neon-600/20 hover:bg-neon-600 border border-neon-500/30 text-xs font-medium text-white transition flex items-center gap-1.5 shrink-0">
                        <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                        คัดลอก
                    </button>
                </div>
            `).join('');
        }

        function copyAllDeliveredKeys() {
            if (lastDeliveredKeys.length === 0) return;
            copyText(lastDeliveredKeys.join('\n'), `คัดลอกคีย์ทั้งหมด ${lastDeliveredKeys.length} รายการแล้ว!`);
        }

        // ==================== ระบบประวัติการสั่งซื้อ (localStorage) ====================

        function getPurchaseHistory() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                return raw ? JSON.parse(raw) : [];
            } catch (e) {
                return [];
            }
        }

        function saveOrderToHistory(order) {
            try {
                const history = getPurchaseHistory();
                history.unshift(order);
                localStorage.setItem(STORAGE_KEY, JSON.stringify(history));
            } catch (e) {
                showToast('ไม่สามารถบันทึกประวัติลงเครื่องได้', 'error');
            }
        }

        function openHistoryModal() {
            renderHistoryList();
            resetClearHistoryControls();
            const modal = document.getElementById('historyModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            lucide.createIcons();
        }

        function closeHistoryModal() {
            const modal = document.getElementById('historyModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function renderHistoryList() {
            const history = getPurchaseHistory();
            const container = document.getElementById('historyListContainer');
            const footer = document.getElementById('historyFooter');

            if (history.length === 0) {
                footer.classList.add('hidden');
                container.innerHTML = `
                    <div class="text-center py-12">
                        <div class="w-16 h-16 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center mx-auto mb-3">
                            <i data-lucide="inbox" class="w-8 h-8 text-purple-400/60"></i>
                        </div>
                        <h4 class="font-display font-semibold text-lg text-white">ยังไม่มีประวัติการสั่งซื้อ</h4>
                        <p class="text-sm text-purple-300/65 mt-1 mb-5">เมื่อคุณสั่งซื้อสินค้า รหัสคีย์ทั้งหมดจะถูกเก็บไว้ที่นี่</p>
                        <button onclick="closeHistoryModal()" class="px-5 py-2.5 rounded-xl bg-neon-600 hover:bg-neon-500 text-white text-sm font-medium transition">
                            ไปเลือกซื้อคีย์
                        </button>
                    </div>
                `;
                return;
            }

            footer.classList.remove('hidden');
            document.getElementById('historyOrderCount').textContent = `ทั้งหมด ${history.length} คำสั่งซื้อ`;

            container.innerHTML = history.map(order => `
                <div class="p-4 sm:p-5 rounded-2xl bg-dark-800/70 border border-purple-500/20 space-y-3">
                    <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-purple-500/15">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-mono font-bold text-sm text-white">${order.orderId}</span>
                                <span class="px-2 py-0.5 rounded-md bg-emerald-500/15 text-emerald-300 text-[11px] font-medium">สำเร็จ</span>
                            </div>
                            <div class="text-xs text-purple-300/65 mt-0.5">${order.date} • ${order.paymentMethod}</div>
                        </div>
                        <div class="text-right">
                            <div class="font-display font-bold text-lg text-neon-400">${order.total.toLocaleString()} ฿</div>
                            ${order.discount > 0 ? `<div class="text-[11px] text-emerald-400">ประหยัดไป ${order.discount.toLocaleString()} ฿</div>` : ''}
                        </div>
                    </div>

                    <div class="space-y-2">
                        ${order.items.map(item => `
                            <div class="px-3.5 py-2.5 rounded-xl bg-dark-950/75 border border-purple-500/15 flex items-center justify-between gap-2">
                                <div class="min-w-0">
                                    <div class="text-xs text-purple-300/75 truncate">${item.productName}</div>
                                    <div class="font-mono font-bold text-xs sm:text-sm text-purple-100 tracking-wider select-all">${item.key}</div>
                                </div>
                                <button onclick="copyText('${item.key}', 'คัดลอกคีย์แล้ว!')" class="px-2.5 py-1.5 rounded-lg bg-purple-500/15 hover:bg-neon-600 text-purple-200 hover:text-white text-xs font-medium transition flex items-center gap-1 shrink-0">
                                    <i data-lucide="copy" class="w-3.5 h-3.5"></i>
                                    คัดลอก
                                </button>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `).join('');

            lucide.createIcons();
        }

        function showClearHistoryConfirm() {
            const controls = document.getElementById('clearHistoryControls');
            controls.innerHTML = `
                <div class="flex items-center gap-2 text-xs">
                    <span class="text-rose-300">ยืนยันการลบ?</span>
                    <button onclick="clearPurchaseHistory()" class="px-2.5 py-1 rounded-lg bg-rose-600 hover:bg-rose-500 text-white font-medium transition">ลบเลย</button>
                    <button onclick="resetClearHistoryControls()" class="px-2.5 py-1 rounded-lg bg-dark-800 hover:bg-dark-700 text-purple-200 transition">ยกเลิก</button>
                </div>
            `;
        }

        function resetClearHistoryControls() {
            const controls = document.getElementById('clearHistoryControls');
            if (!controls) return;
            controls.innerHTML = `
                <button onclick="showClearHistoryConfirm()" class="text-xs text-rose-400 hover:text-rose-300 flex items-center gap-1 transition">
                    <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    ล้างประวัติทั้งหมด
                </button>
            `;
            lucide.createIcons();
        }

        function clearPurchaseHistory() {
            try {
                localStorage.removeItem(STORAGE_KEY);
                renderHistoryList();
                showToast('ล้างประวัติการสั่งซื้อทั้งหมดแล้ว', 'info');
            } catch (e) {
                showToast('ไม่สามารถล้างประวัติได้', 'error');
            }
        }
    </script>
</body>
</html>
